+/*
+ * Largest rate the clock tree can actually produce that is not faster than
+ * @max.  On GXL/AXG this is exact and the loop runs once: the driver pins the
+ * divider's parent to a fixed 1GHz and registers its own divider, so
+ * clk_round_rate() returns 1e9/div unchanged.  On Meson8/8b nand_clk_sel and
+ * nand_clk_div both carry ROUND_CLOSEST (drivers/clk/meson/meson8b.c) and are
+ * therefore allowed to settle ABOVE the requested rate -- which here means
+ * running the bus faster than the chip's tRC_min, a violation that no clk API
+ * reports and that shows up only as intermittent uncorrectable ECC.
+ */
+static unsigned long meson_nfc_clk_rate_at_most(struct meson_nfc *nfc,
+						unsigned long max)
+{
+	unsigned long req = max;
+	long rate;
+	int i;
+
+	for (i = 0; i < 4 && req; i++) {
+		rate = clk_round_rate(nfc->nand_clk, req);
+		if (rate <= 0)
+			return 0;
+		if (rate <= max)
+			return rate;
+		/*
+		 * A round-to-closest clock only answers above the request when
+		 * the next reachable rate below is at least as far away, i.e.
+		 * lower <= 2 * req - rate.  Aim just under that so the next
+		 * query cannot pick the same rate again.
+		 */
+		if ((unsigned long)rate >= 2 * req)
+			break;
+		req = 2 * req - rate - 1;
+	}
+
+	return 0;
+}
